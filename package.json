{
  "name": "void-chat",
  "version": "1.0.0",
  "description": "Ephemeral anonymous chat rooms with end-to-end encryption",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint server.js lib/ public/app.js public/room.js",
    "docker:build": "docker build -t void-chat .",
    "docker:run": "docker run -p 3000:3000 void-chat"
  },
  "dependencies": {
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^8.57.1",
    "nodemon": "^3.0.2",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "vitest": "^2.1.9"
  }
}
